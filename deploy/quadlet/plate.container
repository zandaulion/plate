[Unit]
Description=Plate server (photo-first calorie and macro log)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/plate:latest
ContainerName=plate
PublishPort=127.0.0.1:8096:3000
Volume=plate-data:/data
EnvironmentFile=%h/.config/plate/plate.env
Environment=DATA_DIR=/data
Environment=PORT=3000
Environment=BIND_HOST=0.0.0.0
# PUBLIC_BASE_URL lives in the environment file, not here: it is the one piece
# of deployment detail that would otherwise put a hostname in a public repo.
# Without it the invite API returns a code and no link, which the console
# handles.
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
