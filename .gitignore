node_modules/
data/
.env
*.log

# Competitive positioning and commercial thinking. This repo is public, and
# that analysis helps a competitor more than it helps a contributor. It travels
# to the laptop by another route.
docs/
tools/

# Android Studio and Gradle outputs for the native, local-first client.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
android/app/*.jks
android/app/*.keystore

# Signed upload bundles are local release artifacts. Keep them in store/releases
# for Play Console upload, but never publish a signed binary by accident.
store/releases/*.aab
store/releases/*.apks

# Locally copied APKs can contain release artefacts and are not source or
# Play listing material. Keep them on the machine, outside the public repo.
APKs/
*.apk

# Future Firebase project material belongs in the deployment environment, not
# in the public source repository. (The Android config itself is not a secret,
# but is kept local under Bitey's no-personal-project-details rule.)
android/app/google-services.json
firebase-service-account*.json
service-account*.json
functions/.env*
